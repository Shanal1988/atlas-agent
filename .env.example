# Required
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
FMP_API_KEY=

# Optional — OpenRouter free tier (replaces Anthropic + OpenAI)
OPENROUTER_API_KEY=

# Set this to your Railway frontend URL once deployed (e.g. https://atlas-web.up.railway.app)
CORS_ORIGINS=

# Auth — must match the NEXTAUTH_SECRET in web/.env.local
NEXTAUTH_SECRET=
